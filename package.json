{
  "name": "two-person-video-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Two-person browser extension and playback-state synchronization service.",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "test:unit": "pnpm --filter @watch-sync/protocol test && pnpm --filter @watch-sync/sync-core test",
    "test:integration": "pnpm --filter @watch-sync/server test",
    "test:e2e": "pnpm --filter @watch-sync/e2e test",
    "package": "pnpm --filter @watch-sync/extension package:all",
    "lint:firefox": "web-ext lint --source-dir apps/extension/.output/firefox-mv3 --warnings-as-errors",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "scan:secrets": "secretlint \"**/*\"",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.1.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "eslint": "^9.32.0",
    "eslint-plugin-import-x": "^4.16.1",
    "prettier": "^3.6.2",
    "secretlint": "13.0.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4",
    "web-ext": "10.5.0"
  }
}
