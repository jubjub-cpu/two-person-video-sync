# Synchronization service
HOST=127.0.0.1
PORT=8787
NODE_ENV=development

# Comma-separated extension origins. Local development also accepts localhost page origins.
# Production should list only the released chrome-extension:// and moz-extension:// origins.
ALLOWED_ORIGINS=
ALLOW_EXTENSION_ORIGINS=true
ALLOW_LOCALHOST_ORIGINS=true
ALLOW_MISSING_ORIGIN=false
REQUIRE_SECURE_WEBSOCKET=false
TRUST_PROXY=false

# In-memory room and abuse limits
MAX_PAYLOAD_BYTES=16384
MAX_CONNECTIONS=10000
MAX_CONNECTIONS_PER_IP=20
MAX_PARTICIPANTS_PER_ROOM=8
CONNECTION_ATTEMPTS_PER_MINUTE=60
ROOM_CREATES_PER_HOUR=20
ROOM_JOINS_PER_MINUTE=30
MESSAGES_PER_CONNECTION_PER_10_SECONDS=120
MESSAGES_PER_IP_PER_10_SECONDS=600
ROOM_TTL_MS=21600000
ROOM_IDLE_TTL_MS=1800000
RECONNECT_GRACE_MS=120000
RECONNECT_TOKEN_TTL_MS=21600000
CLEANUP_INTERVAL_MS=30000
SHUTDOWN_TIMEOUT_MS=10000
LOG_LEVEL=info
